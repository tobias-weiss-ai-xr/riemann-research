{
  "defaults": {
    "accept_timeout_s": 1800,
    "max_attempts": 3,
    "retry_delay_s": 60,
    "agent_timeout_s": 7200,
    "no_op_max_attempts": 2,
    "timeout_retry_multiplier": 1.5,
    "provider": "litellm"
  },
  "workers": [
    {
      "name": "riemann-paper-discovery",
      "enabled": true,
      "provider": "litellm",
      "model": "glm-5.2",
      "endpoint": "http://127.0.0.1:4000/v1",
      "api_key_env": "LITELLM_API_KEY",
      "accept_timeout_s": 3600,
      "max_attempts": 5
    },
    {
      "name": "riemann-concept-extraction",
      "enabled": true,
      "provider": "litellm",
      "model": "deepseek-v4-flash",
      "endpoint": "http://127.0.0.1:4000/v1",
      "api_key_env": "LITELLM_API_KEY",
      "accept_timeout_s": 7200,
      "max_attempts": 3
    },
    {
      "name": "riemann-kg-builder",
      "enabled": true,
      "provider": "litellm",
      "model": "glm-5.2",
      "endpoint": "http://127.0.0.1:4000/v1",
      "api_key_env": "LITELLM_API_KEY",
      "accept_timeout_s": 3600,
      "max_attempts": 3
    },
    {
      "name": "riemann-report-generator",
      "enabled": true,
      "provider": "litellm",
      "model": "deepseek-v4-flash",
      "endpoint": "http://127.0.0.1:4000/v1",
      "api_key_env": "LITELLM_API_KEY",
      "accept_timeout_s": 1800,
      "max_attempts": 2
    }
  ]
}