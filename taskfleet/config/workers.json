{
  "defaults": {
    "accept_timeout_s": 1800,
    "max_attempts": 3,
    "retry_delay_s": 60,
    "agent_timeout_s": 7200,
    "no_op_max_attempts": 2,
    "timeout_retry_multiplier": 1.5,
    "provider": "pi"
  },
  "workers": [
    {
      "name": "riemann-paper-discovery",
      "enabled": true,
      "provider": "pi",
      "model": "local",
      "endpoint": "http://127.0.0.1:9090",
      "tiers": ["discovery", "corpus"],
      "accept_timeout_s": 3600,
      "max_attempts": 5
    },
    {
      "name": "riemann-concept-extraction",
      "enabled": true,
      "provider": "pi",
      "model": "local",
      "endpoint": "http://127.0.0.1:9090",
      "tiers": ["concepts", "findings", "knowledge"],
      "accept_timeout_s": 7200,
      "max_attempts": 3
    },
    {
      "name": "riemann-kg-builder",
      "enabled": true,
      "provider": "pi",
      "model": "local",
      "endpoint": "http://127.0.0.1:9090",
      "tiers": ["kg", "dgraph", "neo4j"],
      "accept_timeout_s": 3600,
      "max_attempts": 3
    },
    {
      "name": "riemann-report-generator",
      "enabled": true,
      "provider": "pi",
      "model": "local",
      "endpoint": "http://127.0.0.1:9090",
      "tiers": ["reports", "docs"],
      "accept_timeout_s": 1800,
      "max_attempts": 2
    }
  ]
}
