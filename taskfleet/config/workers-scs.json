{
  "defaults": {
    "accept_timeout_s": 1800,
    "max_attempts": 3,
    "retry_delay_s": 60,
    "agent_timeout_s": 7200,
    "no_op_max_attempts": 2,
    "timeout_retry_multiplier": 1.5,
    "provider": "pi",
    "prompt_template": "prompts-scs/scs-security-hardening.md"
  },
  "workers": [
    {
      "name": "scs-security-01",
      "enabled": true,
      "provider": "pi",
      "model": "local",
      "endpoint": "http://127.0.0.1:9090",
      "tiers": ["security", "critical"],
      "accept_timeout_s": 3600,
      "max_attempts": 5
    },
    {
      "name": "scs-security-02",
      "enabled": false,
      "provider": "openai",
      "model": "gpt-4o",
      "endpoint": "https://api.openai.com/v1",
      "tiers": ["security", "review"]
    },
    {
      "name": "scs-security-03",
      "enabled": false,
      "provider": "anthropic",
      "model": "claude-3-5-sonnet-20250620",
      "endpoint": "https://api.anthropic.com/v1",
      "tiers": ["security", "deep"]
    }
  ]
}
