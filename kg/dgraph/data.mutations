      "noise" <tags> <FS-Enhanced-Pizer-Slopes>
      "eigenvalues" <tags> <FS-Enhanced-Pizer-Slopes>
      "FS-Enhanced-Pizer-Slopes" <dgraph.type> "Finding" } }


