# RP-Definition (Concept)
{ set { "RP-Definition" <id> <RP-Definition>
      "Ramanujan Property" <name> <RP-Definition>
      "concept" <entity_type> <RP-Definition>
      "spectral-theory" <category> <RP-Definition>
      "ramanujan" <subcategory> <RP-Definition>
      "A k-regular graph G is Ramanujan if for every eigenvalue λ of its adjacency\nmatrix A, either λ = ±k or |λ| ≤ 2√(k-1).\nEquivalently: the spectral gap λ₂ ≤ 2√(k-1).\nRamanujan graphs are optimal expanders — they achieve the Alon-Boppana bound.\n" <definition> <RP-Definition>
      "ramanujan" <tags> <RP-Definition>
      "optimal" <tags> <RP-Definition>
      "expander" <tags> <RP-Definition>
      "explicit-construction" <tags> <RP-Definition>
      "ramanujan" <tags> <RP-Definition>
      "optimal" <tags> <RP-Definition>
      "expander" <tags> <RP-Definition>
      "explicit-construction" <tags> <RP-Definition>
      "RP-Definition" <dgraph.type> "Concept" } }


