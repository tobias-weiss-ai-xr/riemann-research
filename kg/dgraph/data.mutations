# FG-GNN-Subgraph-Negative-R2 (Finding)
{ set { "FG-GNN-Subgraph-Negative-R2" <id> <FG-GNN-Subgraph-Negative-R2>
      "Subgraph GNNs achieve R² ≈ 0.69 on train, NEGATIVE on cross-prime test" <name> <FG-GNN-Subgraph-Negative-R2>
      "finding" <entity_type> <FG-GNN-Subgraph-Negative-R2>
      "machine-learning" <category> <FG-GNN-Subgraph-Negative-R2>
      "gnn-cayley" <subcategory> <FG-GNN-Subgraph-Negative-R2>
      "Exp 2" <experiment> <FG-GNN-Subgraph-Negative-R2>
      "Exp 3" <experiment> <FG-GNN-Subgraph-Negative-R2>
      "2026-04-18" <date> <FG-GNN-Subgraph-Negative-R2>
      "{\"model\": \"GAT\", \"layers\": 3, \"hidden_dim\": 128, \"pooling\": \"global_mean_pool\", \"features\": \"3-dim (normalized_degree, clustering_coefficient, triangle_count)\", \"augmentation\": \"BFS subgraphs (size 20-5000)\", \"input\": \"SL(2,F_p) Cayley graphs (p=2..101)\", \"target\": \"spectral_gap (\\u03bb\\u2082)\", \"loss\": \"MSE\"}" <configuration> <FG-GNN-Subgraph-Negative-R2>
      "{\"train\": {\"mae\": 0.116, \"r2\": 0.688, \"loss\": \"~0.03\"}, \"test\": {\"mae\": 0.086, \"r2\": -121.7, \"target_range\": [0.158, 0.174], \"prediction_range\": [0.204, 0.374], \"baseline_r2\": \"null (training mean prediction)\"}}" <results> <FG-GNN-Subgraph-Negative-R2>
      "{\"root_cause\": \"Vertex-transitivity of SL(2,F_p) Cayley graphs means ALL local\\nsubgraph structures are identical across primes (all 4-regular,\\nsame local statistics). Local subgraph features carry ZERO information\\nabout global spectral properties. The model memorizes training primes'\\nspectral gap distribution but fails to generalize to unseen primes.\\n\", \"key_insight\": \"For vertex-transitive graphs, local GNN features cannot predict global spectral properties. Only full-graph information works.\"}" <analysis> <FG-GNN-Subgraph-Negative-R2>
      "confirmed" <status> <FG-GNN-Subgraph-Negative-R2>
      "high" <confidence> <FG-GNN-Subgraph-Negative-R2>
      "vertex-transitive" <tags> <FG-GNN-Subgraph-Negative-R2>
      "no-generalization" <tags> <FG-GNN-Subgraph-Negative-R2>
      "local-features" <tags> <FG-GNN-Subgraph-Negative-R2>
      "failed" <tags> <FG-GNN-Subgraph-Negative-R2>
      "R²-negative" <tags> <FG-GNN-Subgraph-Negative-R2>
      <CS-Vertex-Transitive-Limitation> <references> <FG-GNN-Subgraph-Negative-R2>
      "vertex-transitive" <tags> <FG-GNN-Subgraph-Negative-R2>
      "no-generalization" <tags> <FG-GNN-Subgraph-Negative-R2>
      "local-features" <tags> <FG-GNN-Subgraph-Negative-R2>
      "failed" <tags> <FG-GNN-Subgraph-Negative-R2>
      "R²-negative" <tags> <FG-GNN-Subgraph-Negative-R2>
      "FG-GNN-Subgraph-Negative-R2" <dgraph.type> "Finding" } }


